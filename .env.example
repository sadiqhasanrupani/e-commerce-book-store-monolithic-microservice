# Magic Pages backend: environment template. PLACEHOLDERS ONLY, never put real secrets here.
# Copy to .env.development (read by the app) AND .env (read by the TypeORM migration CLI).
# Full reference: docs/running-the-backend.md

# --- App / HTTP ---
NODE_ENV=development
PORT=8080
API_VERSION=v1
CORS_ORIGIN=http://localhost:8081
FRONTEND_URL=http://localhost:8081
# APP_URL=http://localhost:8080/api/v1

# --- Database ---
DATABASE_URL=postgres://postgres:postgres123@localhost:5433/magic-pages
DATABASE_SYNC=false
DATABASE_AUTOLOAD=true

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
JWT_TOKEN_AUDIENCE=magic-pages-users
JWT_TOKEN_ISSUER=magic-pages-api
# Seconds. Do NOT use "1h" (parseInt turns it into 1 second).
JWT_ACCESS_TOKEN_TTL=3600

# --- Password hashing ---
HASH_ALGO=bcrypt
BCRYPT_SALT_ROUNDS=10
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=5
# ARGON2_PARALLELISM=2

# --- Payments: Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Shipping (paise; 0 = free) ---
SHIPPING_FLAT_RATE_PAISE=0

# --- E-mail (MAIL_PROVIDER = smtp | resend) ---
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_SECURE=false
# RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Object storage (MinIO locally, S3 / DO Spaces in prod) ---
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=magic-pages
STORAGE_PRIVATE_BUCKET=magic-pages-private
STORAGE_REGION=us-east-1

# --- RabbitMQ (required at boot) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/magic-pages
# Leave unset or keep equal to magic-pages-queue (the consumer listens there).
# RABBITMQ_QUEUE=magic-pages-queue

# --- Redis (being removed; still required today) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Cart ---
CART_CLEANUP_STRATEGY=cron

# --- Observability (optional, start:otel* only) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
